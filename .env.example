# Copy to .env, fill in, and load it before running:
#   set -a; . ./.env; set +a
#
# .env is gitignored. Keep it that way.

# ── Telegram ────────────────────────────────────────────────────────────
# Token from @BotFather. Chat id: message your bot once, then read
# result[0].message.chat.id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
RESTOCK_TELEGRAM_TOKEN=
RESTOCK_TELEGRAM_CHAT_ID=

# ── Email ───────────────────────────────────────────────────────────────
# Gmail requires an app password, not your account password.
RESTOCK_SMTP_HOST=smtp.gmail.com
RESTOCK_SMTP_PORT=587
RESTOCK_SMTP_USER=
RESTOCK_SMTP_PASSWORD=
RESTOCK_EMAIL_TO=
RESTOCK_EMAIL_FROM=

# ── Generic webhook ─────────────────────────────────────────────────────
RESTOCK_WEBHOOK_URL=
# Optional; sent as "Authorization: Bearer ..."
RESTOCK_WEBHOOK_TOKEN=
